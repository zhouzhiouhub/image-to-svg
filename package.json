{
  "name": "image-to-svg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-local bitmap ↔ SVG converter. Static SPA, deployable to Cloudflare.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "cf:preview": "pnpm build && wrangler dev"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "esm-potrace-wasm": "^0.5.1",
    "imagetracerjs": "^1.2.6",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-wasm": "^3.6.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
